{
  "name": "therapy-app-lambda-backend",
  "version": "1.0.0",
  "description": "AWS Lambda backend for Psychological Journey therapy app",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "npm run build && npm run zip",
    "zip": "cd dist && zip -r ../deployment-package.zip .",
    "deploy:dev": "aws lambda update-function-code --function-name therapy-app-dev --zip-file fileb://deployment-package.zip",
    "deploy:prod": "aws lambda update-function-code --function-name therapy-app-prod --zip-file fileb://deployment-package.zip",
    "local": "sam local start-api",
    "invoke:local": "sam local invoke"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "@google/generative-ai": "^0.1.3",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/aws-lambda": "^8.10.126",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.15",
    "@types/jest": "^29.5.7",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "aws-sam-cli": "^1.100.0"
  }
}
